# Optional. Browser transcription works without an API key in supported browsers.
# For the OpenAI transcription mode, set your key here (never in VITE_* variables).
OPENAI_API_KEY=

# Optional overrides
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
